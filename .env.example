# Copy to .env and adjust. Never commit .env.

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://vyaparsense:vyaparsense@localhost:5432/vyaparsense

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_ENV=development
LOG_LEVEL=INFO
# Browser origins allowed to call the API (comma-separated). The SPA sends
# cookies, so these must be explicit origins (no wildcard). In production set the
# deployed web origin, e.g. https://vyaparsense.com
CORS_ALLOW_ORIGINS=http://localhost:3000
# Secret for signing auth tokens (custom auth, ADR-006). Generate a strong random value.
AUTH_SECRET=change-me-in-production
