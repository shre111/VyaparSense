# Copy to .env and adjust. Never commit .env.

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://vyaparsense:vyaparsense@localhost:5432/vyaparsense

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_ENV=development
# Secret for signing auth tokens (custom auth, ADR-006). Generate a strong random value.
AUTH_SECRET=change-me-in-production
